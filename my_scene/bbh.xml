<scene version="3.0.0">

    <default name="spp" value="1"/>
<!--    <integrator type="path">-->
<!--        <integer name="max_depth" value="1"/>-->
<!--    </integrator>-->
<!--    <integrator type="depth"/>-->
    <integrator type="gravity">
        <string name="ray_coordinates" value="./ray1.txt"/>
        <string name="lookup_table" value="./lookup_table.txt"/>
        <string name="project_to" value="xz"/>
        <integer name="stride" value="10"/>
    </integrator>

    <sensor type="perspective" id="Camera-camera">
        <float name="fov" value="45"/>
        <transform name="to_world">
            <lookat target="-15, 0, 0"
                    origin="-15, -150, 0"
                    up="0, 0, 1"/>
        </transform>

        <sampler type="independent">
            <integer name="sample_count" value="$spp"/>
        </sampler>

        <film type="hdrfilm" id="film">
            <integer name="width" value="700"/>
            <integer name="height" value="700"/>
            <string name="pixel_format" value="rgb"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <!-- Basic info of BBH system
         m1 = 4, m2 = 1, b = 50,
         The origin (0,0,0) is there rotation center -->
    <shape type="sphere" id="blackhole-1">
        <transform name="to_world">
            <translate x="10" y="0" z="0"/>
        </transform>
        <float name="radius" value="8"/>
    </shape>

    <shape type="sphere" id="blackhole-2">
        <transform name="to_world">
            <translate x="-40" y="0" z="0"/>
        </transform>
        <float name="radius" value="2"/>
    </shape>

    <emitter type="envmap" id="envmap-background">
        <string name="filename" value="./grid.jpg"/>
        <transform name="to_world">
            <lookat target="0, 0, 0"
                    origin="0, 0, 10000"
                    up="1, 0, 0"/>
        </transform>
    </emitter>

</scene>
