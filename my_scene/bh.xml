<scene version="3.0.0">

    <default name="spp" value="64"/>
    <integrator type="path">
        <integer name="rr_depth" value="1"/>
    </integrator>

    <sensor type="perspective" id="Camera-camera">
        <float name="fov" value="45"/>
        <transform name="to_world">
            <lookat target="0, 0, 0"
                    origin="0, -4, 0"
                    up="0, 0, 1"/>
        </transform>

        <sampler type="independent">
            <integer name="sample_count" value="$spp"/>
        </sampler>

        <film type="hdrfilm" id="film">
            <integer name="width" value="720"/>
            <integer name="height" value="720"/>
            <string name="pixel_format" value="rgb"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>

    <emitter type="projector">
        <float name="fov" value="32"/>

        <transform name="to_world">
            <lookat origin="0.0, 4, 0.0" target="0.0, 0.0, 0.0" up="0, 0, 1"/>
        </transform>

        <float name="scale" value="1000"/>

        <texture type="bitmap" name="irradiance">
            <string name="filename" value="./grid.jpeg"/>
        </texture>
    </emitter>

    <shape type="sphere">
        <transform name="to_world">
            <translate y="0"/>
        </transform>
    </shape>

    <shape type="sphere">
        <float name="radius" value="5"/>
<!--        <emitter type="area">-->
<!--            <rgb name="radiance" value="5.0"/>-->
<!--        </emitter>-->
        <boolean name="flip_normals" value="true"/>
        <texture type="bitmap" name="irradiance">
            <string name="filename" value="./grid.jpeg"/>
        </texture>
<!--        <texture name="reflectance" type="checkerboard">-->
<!--            <transform name="to_uv">-->
<!--                <scale x="10" y="10" />-->
<!--            </transform>-->
<!--        </texture>-->
    </shape>
</scene>
